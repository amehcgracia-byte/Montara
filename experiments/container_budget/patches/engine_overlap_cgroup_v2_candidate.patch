diff --git a/core/stages/export.py b/core/stages/export.py
--- a/core/stages/export.py
+++ b/core/stages/export.py
@@ -715,6 +715,23 @@ def _verification_overlap_enabled(project: Project) -> bool:
             meminfo = Path("/proc/meminfo").read_text()
             match = re.search(r"MemAvailable:\s+(\d+) kB", meminfo)
             available = int(match.group(1)) * 1024 if match else 0
-        return memory >= 16 * 1024 ** 3 and available >= 2 * 1024 ** 3
+        if memory < 16 * 1024 ** 3 or available < 2 * 1024 ** 3:
+            return False
+        if sys.platform != "darwin":
+            # A Linux container can have substantially less RAM than its host.
+            limit_file = Path("/sys/fs/cgroup/memory.max")
+            try:
+                raw_limit = limit_file.read_text().strip()
+                if raw_limit != "max":
+                    limit = int(raw_limit)
+                    if limit < 16 * 1024 ** 3:
+                        return False
+                    current = int(Path("/sys/fs/cgroup/memory.current").read_text().strip())
+                    if current < 0 or limit - current < 2 * 1024 ** 3:
