#!/bin/bash
# Executed by macOS Installer as root, never from a web page.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
HERE="$(cd "$(dirname "$0")" && pwd)"
EDITOR_COMMIT="__MONTARA_COMMIT__"
ENGINE_COMMIT="__ENGINE_COMMIT__"

# Always use the logged-in Mac owner, never root's Companion home.
CONSOLE_USER="$(stat -f '%Su' /dev/console)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = root ] || [ "$CONSOLE_USER" = loginwindow ]; then
  echo "Log into your Mac user account before installing Montara Companion." >&2
  exit 1
fi
UID_FOR_USER="$(id -u "$CONSOLE_USER")"
USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | sed 's/^NFSHomeDirectory: //')"
if [ ! -d "$USER_HOME" ] || [ ! -f "$HERE/install.sh" ]; then
  echo "Companion installer or user home unavailable. Download the installer again." >&2
  exit 1
fi

run_as_owner() {
  launchctl asuser "$UID_FOR_USER" sudo -H -u "$CONSOLE_USER" "$@"
}

# Persist useful installation diagnostics so macOS Installer's generic failure
# screen does not hide the actionable error. The log is in the owner's home.
LOG_DIR="$USER_HOME/.montara-companion"
mkdir -p "$LOG_DIR"
chown "$CONSOLE_USER" "$LOG_DIR"
LOG_FILE="$LOG_DIR/installer.log"
touch "$LOG_FILE"
chown "$CONSOLE_USER" "$LOG_FILE"
exec > >(tee -a "$LOG_FILE") 2>&1
echo "Montara Companion installer: $(date) · target ${ENGINE_COMMIT:0:8}"
echo "Installing pinned Montara Companion for $CONSOLE_USER..."
# macOS Installer extracts package scripts in a root-only PKInstallSandbox.
# After dropping privileges the console user CANNOT read $HERE/install.sh.
# Stage a read-only, root-owned copy in an accessible directory first.
STAGE="$(mktemp -d /private/tmp/montara-companion-install.XXXXXXXX)"
trap 'rm -rf "$STAGE"' EXIT
chmod 755 "$STAGE"
cp "$HERE/install.sh" "$STAGE/install.sh"
chown root:wheel "$STAGE/install.sh"
chmod 644 "$STAGE/install.sh"
run_as_owner env \
  "PATH=$PATH" "MONTARA_REF=$EDITOR_COMMIT" "MONTARA_EXPECTED_ENGINE=$ENGINE_COMMIT" \
  MONTARA_NO_SHELL_SETUP=1 MONTARA_INSTALL_ONLY=1 \
  bash "$STAGE/install.sh" --video

# Register a real per-user LaunchAgent. A background process spawned from
# Installer's postinstall may be killed when Installer finishes; launchd owns
# the lifetime instead, including after reboots and future user logins.
LABEL="website.montara.companion"
AGENT_DIR="$USER_HOME/Library/LaunchAgents"
AGENT="$AGENT_DIR/$LABEL.plist"
run_as_owner mkdir -p "$AGENT_DIR"
cat > "$AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$USER_HOME/.montara-companion/bin/montara-companion</string></array>
  <key>RunAtLoad</key><true/>
  <!-- Avoid a rapid relaunch loop when an old Companion already owns 47820. -->
  <key>KeepAlive</key><false/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>$USER_HOME/.montara-companion/companion.log</string>
  <key>StandardErrorPath</key><string>$USER_HOME/.montara-companion/companion.log</string>
</dict>
</plist>
EOF
chown "$CONSOLE_USER" "$AGENT"
chmod 600 "$AGENT"
plutil -lint "$AGENT"
# Check the already-running instance *before* starting a second daemon.
# The previous installer may have left a healthy foreground Companion or a
# second older LaunchAgent running. If it has the exact expected engine, keep
# it running: a duplicate on 47820 is always an error, not a reason to retry.
health_engine() {
  local raw
  raw="$(curl -fsS --max-time 3 http://127.0.0.1:47820/health 2>/dev/null || true)"
  [ -n "$raw" ] || return 1
  printf '%s' "$raw" | run_as_owner python3 -c 'import json,sys;d=json.load(sys.stdin);print((d.get("local_video") or {}).get("engine") or "") if d.get("app")=="montara-companion" else sys.exit(1)' 2>/dev/null
}
current_engine="$(health_engine || true)"
if [ "$current_engine" = "$ENGINE_COMMIT" ]; then
  echo "Matching Companion already running on port 47820; not starting a duplicate."
  echo "LaunchAgent will run at the next user login."
  exit 0
fi

# Unload the older LaunchAgent first, preventing automatic respawn while we
# replace its listener. The installer must never forcibly kill a render.
run_as_owner launchctl bootout "gui/$UID_FOR_USER/$LABEL" >/dev/null 2>&1 || true
for attempt in $(seq 1 15); do
  listeners="$(lsof -nP -t -iTCP:47820 -sTCP:LISTEN 2>/dev/null || true)"
  [ -n "$listeners" ] || break
  sleep 1
done
listeners="$(lsof -nP -t -iTCP:47820 -sTCP:LISTEN 2>/dev/null || true)"
if [ -n "$listeners" ]; then
  # An old foreground Companion may remain, even after bootout. Stop it only
  # when the health API says there are no active local jobs AND the listener
  # belongs to the same logged-in user and the Montara installation.
  raw="$(curl -fsS --max-time 3 http://127.0.0.1:47820/health 2>/dev/null || true)"
  if [ -z "$raw" ] || ! printf '%s' "$raw" | run_as_owner python3 -c 'import json,sys;d=json.load(sys.stdin);sys.exit(0 if d.get("app")=="montara-companion" and d.get("busy") is False else 1)' 2>/dev/null; then
    echo "Port 47820 is occupied and cannot be safely replaced. Quit Companion after its current jobs finish." >&2
    exit 1
  fi
  for pid in $listeners; do
    owner="$(ps -p "$pid" -o user= | xargs || true)"
    cmd="$(ps -p "$pid" -o command= || true)"
    if [ "$owner" != "$CONSOLE_USER" ] || [[ "$cmd" != *"$USER_HOME/.montara-companion/companion.py"* ]]; then
      echo "Port 47820 belongs to another process ($pid). Not stopping it." >&2
      exit 1
    fi
  done
  echo "Stopping the old idle Companion before starting the managed service..."
  for pid in $listeners; do run_as_owner kill -TERM "$pid"; done
  for attempt in $(seq 1 15); do
    [ -z "$(lsof -nP -t -iTCP:47820 -sTCP:LISTEN 2>/dev/null || true)" ] && break
    sleep 1
  done
  if [ -n "$(lsof -nP -t -iTCP:47820 -sTCP:LISTEN 2>/dev/null || true)" ]; then
    echo "Old Companion did not stop. Installer will not start another copy." >&2
    exit 1
  fi
fi
run_as_owner launchctl bootstrap "gui/$UID_FOR_USER" "$AGENT"
# RunAtLoad starts exactly one managed Companion. Do not kickstart -k:
# that can race a just-started process and create port conflicts.

echo "Verifying the launched Companion uses the expected engine..."
for attempt in $(seq 1 35); do
  verified="$(health_engine || true)"
  if [ "$verified" = "$ENGINE_COMMIT" ]; then
    echo "Companion updated, connected, and verified: ${ENGINE_COMMIT:0:8}"
    exit 0
  fi
  sleep 1
done
echo "Companion could not bind to 47820 with the expected engine. See $LOG_FILE and $USER_HOME/.montara-companion/companion.log." >&2
exit 1
